# Copy to deploy/dokploy/.env.production (git-ignored) and fill in, then
#   DOKPLOY_API_KEY=… ./deploy/dokploy/dokploy.sh env && ./deploy/dokploy/dokploy.sh deploy

# --- transport ---------------------------------------------------------------
MCP_TRANSPORT=http
PORT=8080
# Public hostname Traefik forwards; rmcp rejects other Host headers.
MCP_ALLOWED_HOSTS=google-ads-mcp.svc.buildcanada.com
# Shared secret; the same value goes into the Executor connection.
MCP_BEARER_TOKEN=

# --- Google Ads --------------------------------------------------------------
# Manager account (MCC) that holds the developer token.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=194-692-0796
# Default target account the tools operate on (an account under the MCC).
GOOGLE_ADS_CUSTOMER_ID=
# Google Ads → Tools & Settings → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
# Single-line JSON, written to /data/credentials.json at start:
# {"type":"authorized_user","client_id":"…","client_secret":"…","refresh_token":"…"}
GOOGLE_ADS_CREDENTIALS_JSON=

# --- safety rails (see upstream README) ---------------------------------------
GOOGLE_ADS_MAX_DAILY_BUDGET=100
GOOGLE_ADS_MAX_BID_INCREASE_PCT=100
GOOGLE_ADS_REQUIRE_DRY_RUN=true
GOOGLE_ADS_READ_ONLY=false
